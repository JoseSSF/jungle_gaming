{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering transaction processor — Jungle Gaming technical challenge",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:status": "bun run scripts/migrate.ts status",
    "sqs:setup": "bun run scripts/setup-sqs.ts",
    "sqs:send": "bun run scripts/send-message.ts",
    "auth:token": "bun run scripts/get-token.ts",
    "infra:up": "docker compose up -d postgres ministack keycloak",
    "infra:down": "docker compose down -v",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:load": "bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1165.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "decimal.js": "10.6.0",
    "jose": "6.2.17",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.9",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.3",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
