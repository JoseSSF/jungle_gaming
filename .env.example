# Copy to .env for local runs outside Docker (bun run start). Values are the defaults.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# consumer,outbox,pending-references | none
WORKERS=consumer,outbox,pending-references

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
WALLET_LOCK_TIMEOUT_MS=3000
SUBMIT_MAX_CONFLICT_RETRIES=5

SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_AUTO_CREATE_QUEUES=true
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_RETRY_MAX_DELAY_SECONDS=60

OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=10

PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=12
PENDING_REFERENCE_TTL_MS=900000

# keycloak | disabled
AUTH_MODE=disabled
AUTH_ISSUER=http://localhost:8080/realms/jungle
AUTH_JWKS_URL=http://localhost:8080/realms/jungle/protocol/openid-connect/certs
AUTH_AUDIENCE=wagering-api
